# Copy this to .env.local and fill in your values
# NEVER commit .env.local to GitHub

# Higgsfield (admin accounts use these)
VITE_HIGGSFIELD_API_KEY=your_higgsfield_key_here

# Anthropic Claude API
VITE_CLAUDE_API_KEY=your_claude_key_here

# Airtable (admin VideoForge Operations base)
VITE_AIRTABLE_API_KEY=your_airtable_key_here
VITE_AIRTABLE_JOBS_BASE=appXXXXXXXXXXXXXX
VITE_AIRTABLE_JOBS_TABLE=tblXXXXXXXXXXXXXX

# ─── Function auth (server-side only) ───
# Never give these a VITE_ prefix: Vite ships VITE_* vars in the browser bundle.
# Header auth for scripts and CI (sent as x-vf-secret)
VF_API_SECRET=change_this_to_a_long_random_string
# Studio sign-in. Build both with scripts/make-login-user.js
VF_SESSION_SECRET=output_of_make-login-user_--session-secret
VF_LOGIN_USERS={"twila":{"hash":"scrypt$...","admin":true}}

# Admin emails (comma separated - these users get your API keys + preset channels)
VITE_ADMIN_EMAILS=your@email.com,genesis@email.com
